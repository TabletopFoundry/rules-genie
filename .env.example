# ───────────────────────────────────────────────
# RulesGenie Environment Configuration
# ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The app works in demo mode without any API keys.

# ── AI Configuration ──────────────────────────
# Set to 'false' to use OpenAI for real responses.
RULESGENIE_DEMO_MODE=true

# Your OpenAI API key (required only when demo mode is disabled)
OPENAI_API_KEY=

# Override the default OpenAI model
OPENAI_MODEL=gpt-4o-mini

# ── App Configuration ─────────────────────────
# Base URL for metadata (used in OG tags, sitemaps)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Override the SQLite database location.
# Local default: ./rulesgenie.db
# Docker default: /app/data/rulesgenie.db
# RULESGENIE_DB_PATH=./rulesgenie.db
