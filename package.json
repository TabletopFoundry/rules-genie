{
  "name": "rulesgenie",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered board game rules assistant with citation-backed answers, quick-start guides, and a personal dashboard.",
  "keywords": [
    "board-games",
    "rules-assistant",
    "ai",
    "nextjs",
    "openai",
    "sqlite"
  ],
  "license": "MIT",
  "author": "josedab",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx}' '*.{js,ts,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' '*.{js,ts,json,md}'"
  },
  "dependencies": {
    "better-sqlite3": "^12.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "openai": "^4.104.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
